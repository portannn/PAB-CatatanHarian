<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tombol: sudut membulat, tanpa huruf kapital semua. -->
    <style name="Widget.Quartz.Button064" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.Quartz.Button.Outlined064" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="strokeColor">@color/quartz_outline_variant</item>
    </style>

    <!-- Kolom input outlined dengan sudut lembut. -->
    <style name="Widget.Quartz.TextInput064" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- Kartu: garis tipis, tanpa bayangan tebal. -->
    <style name="Widget.Quartz.Card064" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/quartz_outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/quartz_surface</item>
    </style>

    <!-- Gaya teks. -->
    <style name="Text.Quartz.Brand064" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Text.Quartz.Title064" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Text.Quartz.Body064" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Text.Quartz.Overline064" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
